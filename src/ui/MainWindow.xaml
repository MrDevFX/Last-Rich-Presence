<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Last_Rich_Presence.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Last_Rich_Presence"
    Title="Last Rich Presence">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE71D;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Last Rich Presence" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <Border Padding="8,2" CornerRadius="999"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="v2.5.0"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Discord activity bridge"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="ConnectionInfoBar"
                 Grid.Row="1"
                 IsOpen="False"
                 IsClosable="True"
                 Margin="0"/>

        <NavigationView x:Name="NavView"
                        Grid.Row="2"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="True"
                        OpenPaneLength="180"
                        CompactPaneLength="48"
                        SelectionChanged="{x:Bind OnNavSelectionChanged}">
            <NavigationView.Resources>
                <Style TargetType="NavigationViewItem">
                    <Setter Property="Margin" Value="0,2,0,2"/>
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="MinHeight" Value="42"/>
                    <Setter Property="UseSystemFocusVisuals" Value="True"/>
                    <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
                </Style>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavItem" Content="Home" ToolTipService.ToolTip="Home dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontSize="17"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="MusicNavItem" Content="Music" ToolTipService.ToolTip="Now playing and presence settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" FontSize="17"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CreativeNavItem" Content="Creativity" ToolTipService.ToolTip="Creativity and design activity">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Edit"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ProductivityNavItem" Content="Productivity" ToolTipService.ToolTip="Focus and productivity activity">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Bullets"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsNavItem" Content="Settings" ToolTipService.ToolTip="App info and diagnostics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontSize="17"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24">
                <Grid.Transitions>
                    <TransitionCollection>
                        <RepositionThemeTransition/>
                    </TransitionCollection>
                </Grid.Transitions>

                <local:HomePageControl x:Name="HomePage" Visibility="Visible"/>
                <local:MusicPageControl x:Name="MusicPage" Visibility="Collapsed"/>
                <local:ProductivityPageControl x:Name="ProductivityPage" Visibility="Collapsed"/>
                <local:CreativePageControl x:Name="CreativePage" Visibility="Collapsed"/>
                <local:SettingsPageControl x:Name="SettingsPage" Visibility="Collapsed"/>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
