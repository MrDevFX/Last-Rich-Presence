<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Last_Rich_Presence.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Last Rich Presence">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE71D;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Last Rich Presence" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <Border Padding="8,2" CornerRadius="999"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="v1.0.0"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Discord activity bridge"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Connection InfoBar (visible across all pages) -->
        <InfoBar x:Name="ConnectionInfoBar"
                 Grid.Row="1"
                 IsOpen="False"
                 IsClosable="True"
                 Margin="0,0,0,0"/>

        <!-- Main Content -->
        <NavigationView x:Name="NavView"
                          Grid.Row="2"
                          PaneDisplayMode="Left"
                          IsBackButtonVisible="Collapsed"
                          IsSettingsVisible="False"
                          IsPaneToggleButtonVisible="True"
                          OpenPaneLength="180"
                          CompactPaneLength="48"
                          SelectionChanged="{x:Bind OnNavSelectionChanged}">
            <NavigationView.Resources>
                <Style TargetType="NavigationViewItem">
                    <Setter Property="Margin" Value="0,2,0,2"/>
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="MinHeight" Value="42"/>
                    <Setter Property="UseSystemFocusVisuals" Value="True"/>
                    <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
                </Style>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavItem" Content="Home" Tag="Home" IsSelected="True" ToolTipService.ToolTip="Home dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontSize="17"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="MusicNavItem" Content="Music" Tag="Music" ToolTipService.ToolTip="Now playing and presence settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" FontSize="17"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ProductivityNavItem" Content="Productivity" Tag="Productivity" ToolTipService.ToolTip="Focus and productivity activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C3;" FontSize="17"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CreativeNavItem" Content="Creative" Tag="Creative" ToolTipService.ToolTip="Creative and design activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE160;" FontSize="17"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsNavItem" Content="Settings" Tag="Settings" ToolTipService.ToolTip="App info and diagnostics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontSize="17"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Content Area -->
            <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24">
                <Grid.Transitions>
                    <TransitionCollection>
                        <RepositionThemeTransition/>
                    </TransitionCollection>
                </Grid.Transitions>
                <!-- ============ HOME PAGE ============ -->
                <StackPanel x:Name="HomePage" Visibility="Visible">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="28" IsStaggeringEnabled="True"/>
                            <RepositionThemeTransition/>
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <!-- Connection Status Card -->
                    <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,16" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                             <Ellipse x:Name="StatusIndicator"
                                      Width="12" Height="12" Margin="0,0,14,0"
                                      Fill="{StaticResource StatusDisconnectedBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusText" Text="Disconnected from Discord"
                                                Style="{StaticResource CardTitleTextStyle}"/>
                                    <StackPanel x:Name="StatusLiveBadge"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                        <Ellipse x:Name="StatusLiveDot"
                                                 Width="7" Height="7"
                                                 Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                                        <TextBlock Text="Live"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="StatusSubtext" Text="Waiting for connection..."
                                            Style="{StaticResource SecondaryBodyTextStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="HomeHealthText"
                                           Text="Discord: -- | Bridge: -- | Hint age: --"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           FontFamily="Cascadia Mono"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="EnableToggle"
                                          OnContent=""
                                          OffContent=""
                                          IsOn="True" Toggled="{x:Bind OnEnableToggled}"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Home Dashboard Row -->
                    <Grid x:Name="HomeDashboardGrid" Margin="0,0,0,16" ColumnSpacing="16" RowSpacing="0">
                        <Grid.Transitions>
                            <TransitionCollection>
                                <RepositionThemeTransition/>
                            </TransitionCollection>
                        </Grid.Transitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="HomeDashboardNarrow">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0"/>
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="HomeDashboardGrid.ColumnSpacing" Value="0"/>
                                        <Setter Target="HomeDashboardGrid.RowSpacing" Value="16"/>
                                        <Setter Target="HomeSourceCard.(Grid.Column)" Value="0"/>
                                        <Setter Target="HomeSourceCard.(Grid.Row)" Value="0"/>
                                        <Setter Target="HomeSourceCard.(Grid.ColumnSpan)" Value="2"/>
                                        <Setter Target="HomeMiniPlayer.(Grid.Column)" Value="0"/>
                                        <Setter Target="HomeMiniPlayer.(Grid.Row)" Value="1"/>
                                        <Setter Target="HomeMiniPlayer.(Grid.ColumnSpan)" Value="2"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="HomeDashboardWide">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="980"/>
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="HomeDashboardGrid.ColumnSpacing" Value="16"/>
                                        <Setter Target="HomeDashboardGrid.RowSpacing" Value="0"/>
                                        <Setter Target="HomeSourceCard.(Grid.Column)" Value="0"/>
                                        <Setter Target="HomeSourceCard.(Grid.Row)" Value="0"/>
                                        <Setter Target="HomeSourceCard.(Grid.ColumnSpan)" Value="1"/>
                                        <Setter Target="HomeMiniPlayer.(Grid.Column)" Value="1"/>
                                        <Setter Target="HomeMiniPlayer.(Grid.Row)" Value="0"/>
                                        <Setter Target="HomeMiniPlayer.(Grid.ColumnSpan)" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Current Source Card -->
                        <Border x:Name="HomeSourceCard" Style="{StaticResource SettingsCardStyle}" Padding="16">
                            <StackPanel>
                                 <TextBlock Text="CURRENT SOURCE" Style="{StaticResource SectionOverlineTextStyle}" Margin="0,0,0,10"/>
                                <TextBlock x:Name="HomeSourceValue" Text="No active source"
                                            Margin="0,0,0,0"
                                            Style="{StaticResource CardTitleTextStyle}"
                                            TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <TextBlock x:Name="HomeSourceSubtext" Text="Waiting for active session"
                                           Margin="0,4,0,0"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <TextBlock x:Name="HomeDetectedViaText" Text="Detected via Windows session"
                                           Margin="0,2,0,0"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>

                                <Border Margin="0,12,0,0"
                                        Padding="14,10"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="HomeExtensionIndicator"
                                                 Width="8" Height="8" Margin="0,0,8,0"
                                                 Fill="{StaticResource StatusDisconnectedBrush}"
                                                 VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="HomeExtensionText"
                                                       Text="Browser extension"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1"/>
                                            <TextBlock x:Name="HomeExtensionSubtext"
                                                       Text="Waiting for hints"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Current Activity Card -->
                        <Border x:Name="HomeMiniPlayer" Grid.Column="1" Style="{StaticResource SettingsCardStyle}" Padding="18">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="CURRENT ACTIVITY"
                                               Style="{StaticResource SectionOverlineTextStyle}"/>

                                    <Border Grid.Column="1"
                                            Padding="10,4"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="999">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon x:Name="HomeMiniPlayIcon" Glyph="&#xE768;"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="Live"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="54" Height="54"
                                            Margin="0,0,12,0"
                                            CornerRadius="10"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <Grid>
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="10">
                                                <FontIcon Glyph="&#xE8D6;" FontSize="20"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            </Border>
                                            <Image x:Name="HomeMiniThumbnail" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,54,54"/>
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock x:Name="HomeMiniTitle" Text="Nothing playing"
                                                   Style="{StaticResource CardTitleTextStyle}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        <TextBlock x:Name="HomeMiniArtist" Text="Start playback or activity"
                                                   Style="{StaticResource SecondaryBodyTextStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="6">
                                        <Border Padding="8,3"
                                                HorizontalAlignment="Right"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <TextBlock x:Name="HomeMiniTimer" Text="0:00 / 0:00"
                                                       Style="{StaticResource TimerTextStyle}"/>
                                        </Border>
                                        <Border x:Name="HomePausedChip"
                                                Visibility="Collapsed"
                                                Padding="8,2"
                                                HorizontalAlignment="Right"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="999">
                                            <TextBlock Text="Paused"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <Border x:Name="HomeTrackSkeletonOverlay"
                                            Grid.ColumnSpan="3"
                                            Visibility="Collapsed"
                                            IsHitTestVisible="False"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            CornerRadius="10"
                                            Padding="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="54" Height="54" Margin="0,0,12,0"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="10"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                                <Border Width="168" Height="13"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="4"/>
                                                <Border Width="120" Height="11"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="4"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="6">
                                                <Border Width="74" Height="16"
                                                        HorizontalAlignment="Right"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="6"/>
                                                <Border Width="52" Height="11"
                                                        HorizontalAlignment="Right"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="4"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid x:Name="HomeMiniWaveViewport"
                                      Height="8"
                                      VerticalAlignment="Center">
                                    <Border Height="8"
                                            CornerRadius="4"
                                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"/>

                                    <Path x:Name="HomeMiniWaveTrackPath"
                                          Stretch="Fill"
                                          Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                                          StrokeThickness="1"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          VerticalAlignment="Center"
                                          Data="M0,4 C4,1.6 8,6.4 12,4 C16,1.6 20,6.4 24,4 C28,1.6 32,6.4 36,4 C40,1.6 44,6.4 48,4 C52,1.6 56,6.4 60,4 C64,1.6 68,6.4 72,4 C76,1.6 80,6.4 84,4 C88,1.6 92,6.4 96,4 C100,1.6 104,6.4 108,4 C112,1.6 116,6.4 120,4"/>

                                    <Grid>
                                        <Grid.Clip>
                                            <RectangleGeometry x:Name="HomeMiniWaveFillClip" Rect="0,0,0,8"/>
                                        </Grid.Clip>
                                        <Path x:Name="HomeMiniWaveFillPath"
                                              Stretch="Fill"
                                              Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Opacity="0.95"
                                              VerticalAlignment="Center"
                                              Data="M0,4 C4,1.6 8,6.4 12,4 C16,1.6 20,6.4 24,4 C28,1.6 32,6.4 36,4 C40,1.6 44,6.4 48,4 C52,1.6 56,6.4 60,4 C64,1.6 68,6.4 72,4 C76,1.6 80,6.4 84,4 C88,1.6 92,6.4 96,4 C100,1.6 104,6.4 108,4 C112,1.6 116,6.4 120,4">
                                            <Path.RenderTransform>
                                                <TranslateTransform x:Name="HomeMiniWaveFillTransform"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>

                                    <ProgressBar x:Name="HomeMiniProgressBar"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="0"
                                                 Height="1"
                                                 Opacity="0"
                                                 IsHitTestVisible="False"
                                                 Visibility="Collapsed"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="Last Rich Presence v1.0"
                               Style="{StaticResource SubtleCaptionTextStyle}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- ============ MUSIC PAGE ============ -->
                <ScrollViewer x:Name="MusicPage" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True"/>
                                <RepositionThemeTransition/>
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>

                        <!-- Empty State (shown when nothing is playing) -->
                        <StackPanel x:Name="MusicEmptyState" Visibility="Visible"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,60,0,0">
                            <FontIcon Glyph="&#xE8D6;" FontSize="64"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      Margin="0,0,0,16"/>
                            <TextBlock Text="Nothing playing"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Start playing something to see it here"
                                       Style="{StaticResource SubtleCaptionTextStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Now Playing Card (shown when something is playing) -->
                        <Border x:Name="NowPlayingCard" Style="{StaticResource SettingsCardStyle}"
                                Padding="20" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="NOW PLAYING"
                                               Style="{StaticResource SectionOverlineTextStyle}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <Border Grid.Column="1" Padding="10,4" CornerRadius="999"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock x:Name="PlaybackStateText" Text="Idle"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Album Art -->
                                    <Grid Width="96" Height="96" Margin="0,0,16,0"
                                          CornerRadius="10" VerticalAlignment="Top">
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="10">
                                            <FontIcon Glyph="&#xE8D6;" FontSize="34"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </Border>
                                        <Image x:Name="AlbumThumbnail" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,96,96"/>
                                            </Image.Clip>
                                        </Image>
                                    </Grid>

                                    <!-- Song Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock x:Name="SongTitle" Text="Nothing playing"
                                                   Style="{StaticResource TrackTitleTextStyle}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        <TextBlock x:Name="ArtistName" Text="&#x2014;"
                                                   Style="{StaticResource SecondaryBodyTextStyle}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        <TextBlock x:Name="AlbumName" Text=""
                                                   Style="{StaticResource SubtleCaptionTextStyle}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    </StackPanel>
                                </Grid>

                                <Border Padding="12" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="PositionText" Text="0:00"
                                                   Style="{StaticResource TimerTextStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Grid Grid.Column="1" x:Name="SongWaveViewport"
                                              Margin="12,0" Height="12" VerticalAlignment="Center">
                                            <Border Height="12"
                                                    CornerRadius="6"
                                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"/>

                                            <Path x:Name="SongWaveTrackPath"
                                                  Stretch="Fill"
                                                  Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                                                  StrokeThickness="1.25"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  VerticalAlignment="Center"
                                                  Data="M0,6 C4,2 8,10 12,6 C16,2 20,10 24,6 C28,2 32,10 36,6 C40,2 44,10 48,6 C52,2 56,10 60,6 C64,2 68,10 72,6 C76,2 80,10 84,6 C88,2 92,10 96,6 C100,2 104,10 108,6 C112,2 116,10 120,6"/>

                                            <Grid>
                                                <Grid.Clip>
                                                    <RectangleGeometry x:Name="SongWaveFillClip" Rect="0,0,0,12"/>
                                                </Grid.Clip>
                                                <Path x:Name="SongWaveFillPath"
                                                      Stretch="Fill"
                                                      Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Opacity="0.95"
                                                      VerticalAlignment="Center"
                                                      Data="M0,6 C4,2 8,10 12,6 C16,2 20,10 24,6 C28,2 32,10 36,6 C40,2 44,10 48,6 C52,2 56,10 60,6 C64,2 68,10 72,6 C76,2 80,10 84,6 C88,2 92,10 96,6 C100,2 104,10 108,6 C112,2 116,10 120,6">
                                                    <Path.RenderTransform>
                                                        <TranslateTransform x:Name="SongWaveFillTransform"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Grid>

                                            <ProgressBar x:Name="SongProgressBar"
                                                         Minimum="0" Maximum="100" Value="0"
                                                         Height="1"
                                                         Opacity="0"
                                                         IsHitTestVisible="False"
                                                         Visibility="Collapsed"/>
                                        </Grid>
                                        <TextBlock Grid.Column="2" x:Name="DurationText" Text="0:00"
                                                   Style="{StaticResource TimerTextStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </Border>

                                <!-- Source Badge -->
                                  <Border x:Name="SourceBadge" Margin="0,2,0,0" Padding="10,6"
                                          Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                          BorderThickness="1"
                                          CornerRadius="8" HorizontalAlignment="Left"
                                          Visibility="Collapsed">
                                     <StackPanel>
                                         <StackPanel Orientation="Horizontal">
                                             <FontIcon Glyph="&#xE8D6;" FontSize="12" Margin="0,0,6,0"/>
                                             <TextBlock x:Name="SourceText" Text="No source"
                                                        Style="{StaticResource CaptionTextBlockStyle}"/>
                                         </StackPanel>
                                         <TextBlock x:Name="SourceDebugText"
                                                    Text=""
                                                    Visibility="Collapsed"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Margin="18,4,0,0"
                                                    TextWrapping="Wrap"
                                                    MaxWidth="420"/>
                                     </StackPanel>
                                 </Border>
                             </StackPanel>
                         </Border>

                        <!-- ============ MUSIC SETTINGS (inside Music page) ============ -->
                        <TextBlock Text="PRESENCE SETTINGS"
                                   Style="{StaticResource SectionOverlineTextStyle}"
                                   Margin="0,8,0,12"/>

                        <!-- Show Timestamps -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Show Timestamps" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="Display elapsed/remaining time on your profile"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="TimestampToggle" IsOn="True"
                                              Toggled="{x:Bind OnTimestampToggled}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Show Source App -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Show Source App" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="Display which app/browser is playing"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="SourceToggle" IsOn="True"
                                               Toggled="{x:Bind OnSourceToggled}"
                                               VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Source Debug Mode -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Source Debug Mode" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="Show appId, detection rule, and confidence score"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="SourceDebugToggle" IsOn="False"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Show Paused Media -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Show Paused Media" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="Keep presence visible when playback is paused"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="PausedToggle" IsOn="True"
                                              Toggled="{x:Bind OnPausedToggled}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Show Album Art on Discord -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Show Album Art" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="Upload and display album cover on your Discord profile"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="AlbumArtToggle" IsOn="True"
                                              Toggled="{x:Bind OnAlbumArtToggled}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Supported Sources info -->
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Supported Sources" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Spotify, Apple Music, YouTube Music (browser), Tidal, Deezer, foobar2000, VLC, MusicBee, AIMP, Winamp, iTunes, Groove Music, SoundCloud (browser), Amazon Music, and any app that uses Windows Media Controls."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ PRODUCTIVITY PAGE ============ -->
                <ScrollViewer x:Name="ProductivityPage" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="20" IsStaggeringEnabled="True"/>
                                <RepositionThemeTransition/>
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>

                        <TextBlock Text="PRODUCTIVITY"
                                   Style="{StaticResource SectionOverlineTextStyle}"
                                   Margin="0,0,0,12"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Productivity RPC (In Progress)"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="This section will host rich presence support for focus and work apps."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Planned integrations"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="Notion, VS Code, Cursor, Obsidian, Google Docs, and browser-based work tools."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ CREATIVE PAGE ============ -->
                <ScrollViewer x:Name="CreativePage" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="20" IsStaggeringEnabled="True"/>
                                <RepositionThemeTransition/>
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>

                        <TextBlock Text="CREATIVE"
                                   Style="{StaticResource SectionOverlineTextStyle}"
                                   Margin="0,0,0,12"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Creative RPC (In Progress)"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="This section will host rich presence support for creative and design workflows."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Planned integrations"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="Adobe Photoshop, Illustrator, Premiere Pro, After Effects, Lightroom, Figma, Blender, and other creator tools."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ SETTINGS PAGE ============ -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <RepositionThemeTransition/>
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>

                        <TextBlock Text="APP BEHAVIOR" Style="{StaticResource SectionOverlineTextStyle}"
                                   Margin="0,0,0,12"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Close button minimizes to tray" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="If off, clicking X fully exits the app"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="CloseToTrayToggle" IsOn="True"
                                                  Toggled="OnCloseToTrayToggled"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Launch on Windows startup" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Automatically start Last Rich Presence when you sign in"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="LaunchOnStartupToggle" IsOn="False"
                                                  Toggled="OnLaunchOnStartupToggled"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Start minimized to tray" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Launch in background and keep window hidden"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="StartMinimizedToggle" IsOn="False"
                                                  Toggled="OnStartMinimizedToggled"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Tray left-click toggles window" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="If off, left-click only restores the app"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="TrayLeftClickToggle" IsOn="True"
                                                  Toggled="OnTrayLeftClickToggleToggled"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="PRIVACY &amp; SAFETY" Style="{StaticResource SectionOverlineTextStyle}"
                                   Margin="0,16,0,12"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Sensitive keyword filter" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Hide known adult/NSFW content from Discord"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="SensitiveFilterToggle" IsOn="True"
                                                  Toggled="OnSensitiveKeywordFilterToggled"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Strict unknown-browser privacy" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Treat unknown browser sessions as private media"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="StrictBrowserPrivacyToggle" IsOn="False"
                                                  Toggled="OnStrictBrowserPrivacyToggled"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Suppress browser album art" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Avoid art uploads for browser-detected sessions"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="SuppressBrowserArtToggle" IsOn="False"
                                                  Toggled="OnSuppressBrowserArtToggled"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Blocked apps/sites list" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="Comma, semicolon, or newline separated terms (e.g. chrome.exe, youtube.com). Any match is hidden as private media."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="BlockedAppSitesBox"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="74"
                                                 PlaceholderText="spotify.exe, youtube.com, twitch"/>
                                        <Button Grid.Column="1" Content="Apply"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Bottom"
                                                Click="OnApplyBlockedAppSitesClicked"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="SETTINGS UX" Style="{StaticResource SectionOverlineTextStyle}"
                                   Margin="0,16,0,12"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Reset to Defaults" Click="OnResetSettingsClicked"/>
                                    <Button Grid.Column="1" Content="Export Settings" Margin="8,0,0,0"
                                            Click="OnExportSettingsJsonClicked"/>
                                    <Button Grid.Column="2" Content="Import Settings" Margin="8,0,0,0"
                                            Click="OnImportSettingsJsonClicked"/>
                                </Grid>
                                <TextBlock Text="Export/Import uses settings-export.json in the app local data folder."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="APP INFO" Style="{StaticResource SectionOverlineTextStyle}"
                                   Margin="0,0,0,12"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid MinHeight="64">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="56" Height="56"
                                            Margin="0,0,12,0"
                                            CornerRadius="12"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            VerticalAlignment="Center">
                                        <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png"
                                               Width="44" Height="44"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="Last Rich Presence" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Desktop Discord Rich Presence bridge"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="v1.0.0"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                                 <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                 <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="Shows your current activity context on Discord using Windows media sessions and browser hints when available."/>

                                 <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                 <TextBlock Text="HOW IT WORKS"
                                            Style="{StaticResource SectionOverlineTextStyle}"/>
                                 <StackPanel Spacing="4">
                                     <TextBlock TextWrapping="Wrap"
                                                Style="{StaticResource SecondaryBodyTextStyle}"
                                                Text="1. Detects media sessions from Windows and supported browsers."/>
                                     <TextBlock TextWrapping="Wrap"
                                                Style="{StaticResource SecondaryBodyTextStyle}"
                                                Text="2. Converts track details and playback state into Discord Rich Presence."/>
                                     <TextBlock TextWrapping="Wrap"
                                                Style="{StaticResource SecondaryBodyTextStyle}"
                                                Text="3. Keeps your profile updated while playback changes."/>
                                 </StackPanel>
                             </StackPanel>
                         </Border>

                        <TextBlock Text="SUPPORT" Style="{StaticResource SectionOverlineTextStyle}"
                                   Margin="0,16,0,12"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Verification command" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBox Text=".\scripts\verify.ps1"
                                         IsReadOnly="True"
                                         FontFamily="Cascadia Mono"
                                         TextWrapping="NoWrap"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                                <TextBlock Text="Run this before sharing issue reports so build/runtime checks are included."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="DIAGNOSTICS" Style="{StaticResource SectionOverlineTextStyle}"
                                   Margin="0,16,0,12"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Runtime Log" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <Button Grid.Column="1" Content="Export JSON" Margin="0,0,8,0"
                                            Click="OnExportDiagnosticsJsonClicked"/>
                                    <Button Grid.Column="2" Content="Clear"
                                            Click="OnClearDiagnosticsClicked"/>
                                </Grid>
                                <TextBlock Text="Recent merge and extension bridge events"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                 <TextBox x:Name="DiagnosticsLogBox"
                                          Height="220"
                                          TextWrapping="NoWrap"
                                          IsReadOnly="True"
                                          AcceptsReturn="True"
                                          FontFamily="Consolas"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
