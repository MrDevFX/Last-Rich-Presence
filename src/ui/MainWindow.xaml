                                                  Content="Acrobat" IsChecked="True"
                                                  Checked="OnCreativeAppFilterToggled"
                                                  Unchecked="OnCreativeAppFilterToggled"/>
                                        <CheckBox Grid.Row="6" Grid.Column="1" x:Name="CreativeAppOtherAdobeCheck"
                                                  Content="Other Adobe apps" IsChecked="True"
                                                  Checked="OnCreativeAppFilterToggled"
                                                  Unchecked="OnCreativeAppFilterToggled"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Privacy &amp; idle behavior"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Privacy mode"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <ComboBox x:Name="CreativePrivacyCombo"
                                                  SelectedIndex="0"
                                                  SelectionChanged="OnCreativeSelectionChanged">
                                            <ComboBoxItem Content="Normal"/>
                                            <ComboBoxItem Content="App only"/>
                                            <ComboBoxItem Content="Private"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Idle behavior"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <ComboBox x:Name="CreativeIdleBehaviorCombo"
                                                  SelectedIndex="0"
                                                  SelectionChanged="OnCreativeSelectionChanged">
                                            <ComboBoxItem Content="Hold last creativity activity (5s)"/>
                                            <ComboBoxItem Content="Clear immediately"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Future planned integration"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="Planned non-Adobe creator tools: Blender, Autodesk Maya, Figma, and similar creative apps."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ SETTINGS PAGE ============ -->
                <ScrollViewer x:Name="SettingsPage"
                              Visibility="Collapsed"
                              VerticalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <RepositionThemeTransition/>
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>

                        <TextBlock Text="APP BEHAVIOR" Style="{StaticResource SectionOverlineTextStyle}"
                                   Margin="0,0,0,12"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Close button minimizes to tray" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="If off, clicking X fully exits the app"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="CloseToTrayToggle" IsOn="True"
                                                  Toggled="OnCloseToTrayToggled"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Launch on Windows startup" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Automatically start Last Rich Presence when you sign in"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="LaunchOnStartupToggle" IsOn="False"
                                                  Toggled="OnLaunchOnStartupToggled"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Start minimized to tray" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Launch in background and keep window hidden"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="StartMinimizedToggle" IsOn="False"
                                                  Toggled="OnStartMinimizedToggled"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Tray left-click toggles window" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="If off, left-click only restores the app"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="TrayLeftClickToggle" IsOn="True"
                                                  Toggled="OnTrayLeftClickToggleToggled"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="DISCORD ACTIVITY TYPES" Style="{StaticResource SectionOverlineTextStyle}"
                                   Margin="0,16,0,12"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Media activity type" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Controls how Music/Media appears on Discord"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              x:Name="MediaActivityTypeCombo"
                                              MinWidth="220"
                                              SelectedIndex="0"
                                              SelectionChanged="OnActivityTypeSelectionChanged"
                                              VerticalAlignment="Center">
                                        <ComboBoxItem Content="Auto (Default)"/>
                                        <ComboBoxItem Content="Playing (0)"/>
                                        <ComboBoxItem Content="Listening (2)"/>
                                        <ComboBoxItem Content="Watching (3)"/>
                                        <ComboBoxItem Content="Competing (5)"/>
                                    </ComboBox>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Creativity activity type" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Controls how Creativity appears on Discord"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              x:Name="CreativeActivityTypeCombo"
                                              MinWidth="220"
                                              SelectedIndex="0"
                                              SelectionChanged="OnActivityTypeSelectionChanged"
                                              VerticalAlignment="Center">
                                        <ComboBoxItem Content="Auto (Default)"/>
                                        <ComboBoxItem Content="Playing (0)"/>
                                        <ComboBoxItem Content="Listening (2)"/>
                                        <ComboBoxItem Content="Watching (3)"/>
                                        <ComboBoxItem Content="Competing (5)"/>
                                    </ComboBox>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Productive activity type" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Controls how Productive apps appear on Discord"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              x:Name="ProductiveActivityTypeCombo"
                                              MinWidth="220"
                                              SelectedIndex="0"
                                              SelectionChanged="OnActivityTypeSelectionChanged"
                                              VerticalAlignment="Center">
                                        <ComboBoxItem Content="Auto (Default)"/>
                                        <ComboBoxItem Content="Playing (0)"/>
                                        <ComboBoxItem Content="Listening (2)"/>
                                        <ComboBoxItem Content="Watching (3)"/>
                                        <ComboBoxItem Content="Competing (5)"/>
                                    </ComboBox>
                                </Grid>

                                <TextBlock Text="Supported values in this app: 0, 2, 3, 5"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="PRIVACY &amp; SAFETY" Style="{StaticResource SectionOverlineTextStyle}"
                                   Margin="0,16,0,12"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Sensitive keyword filter" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Hide known adult/NSFW content from Discord"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="SensitiveFilterToggle" IsOn="True"
                                                  Toggled="OnSensitiveKeywordFilterToggled"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Strict unknown-browser privacy" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Treat unknown browser sessions as private media"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="StrictBrowserPrivacyToggle" IsOn="False"
                                                  Toggled="OnStrictBrowserPrivacyToggled"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Suppress browser album art" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Avoid art uploads for browser-detected sessions"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="SuppressBrowserArtToggle" IsOn="False"
                                                  Toggled="OnSuppressBrowserArtToggled"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Blocked apps/sites list" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="Comma, semicolon, or newline separated terms (e.g. chrome.exe, youtube.com). Any match is hidden as private media."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="BlockedAppSitesBox"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="74"
                                                 PlaceholderText="spotify.exe, youtube.com, twitch"/>
                                        <Button Grid.Column="1" Content="Apply"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Bottom"
                                                Click="OnApplyBlockedAppSitesClicked"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="SETTINGS UX" Style="{StaticResource SectionOverlineTextStyle}"
                                   Margin="0,16,0,12"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Choose Light, Dark, or follow the system theme"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              x:Name="ThemeModeCombo"
                                              MinWidth="220"
                                              SelectedIndex="2"
                                              SelectionChanged="OnThemeSelectionChanged"
                                              VerticalAlignment="Center">
                                        <ComboBoxItem Content="Light Mode"/>
                                        <ComboBoxItem Content="Dark Mode"/>
                                        <ComboBoxItem Content="Follow System Default"/>
                                    </ComboBox>
                                </Grid>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Reset to Defaults" Click="OnResetSettingsClicked"/>
                                    <Button Grid.Column="1" Content="Export Settings" Margin="8,0,0,0"
                                            Click="OnExportSettingsJsonClicked"/>
                                    <Button Grid.Column="2" Content="Import Settings" Margin="8,0,0,0"
                                            Click="OnImportSettingsJsonClicked"/>
                                </Grid>
                                <TextBlock Text="Export/Import uses settings-export.json in the app local data folder."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="APP INFO" Style="{StaticResource SectionOverlineTextStyle}"
                                   Margin="0,0,0,12"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid MinHeight="64">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="56" Height="56"
                                            Margin="0,0,12,0"
                                            CornerRadius="12"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            VerticalAlignment="Center">
                                        <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png"
                                               Width="44" Height="44"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="Last Rich Presence" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Desktop Discord Rich Presence bridge"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="v2.0.0"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                                 <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                 <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="Shows your current activity context on Discord using Windows media sessions and browser hints when available."/>

                                 <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                 <TextBlock Text="HOW IT WORKS"
                                            Style="{StaticResource SectionOverlineTextStyle}"/>
                                 <StackPanel Spacing="4">
                                     <TextBlock TextWrapping="Wrap"
                                                Style="{StaticResource SecondaryBodyTextStyle}"
                                                Text="1. Detects media sessions from Windows and supported browsers."/>
                                     <TextBlock TextWrapping="Wrap"
                                                Style="{StaticResource SecondaryBodyTextStyle}"
                                                Text="2. Converts track details and playback state into Discord Rich Presence."/>
                                     <TextBlock TextWrapping="Wrap"
                                                Style="{StaticResource SecondaryBodyTextStyle}"
                                                Text="3. Keeps your profile updated while playback changes."/>
                                 </StackPanel>
                             </StackPanel>
                         </Border>

                        <TextBlock Text="SUPPORT" Style="{StaticResource SectionOverlineTextStyle}"
                                   Margin="0,16,0,12"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Verification command" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBox Text=".\scripts\verify.ps1"
                                         IsReadOnly="True"
                                         FontFamily="Cascadia Mono"
                                         TextWrapping="NoWrap"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                                <TextBlock Text="Run this before sharing issue reports so build/runtime checks are included."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="DIAGNOSTICS" Style="{StaticResource SectionOverlineTextStyle}"
                                   Margin="0,16,0,12"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Runtime Log" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <Button Grid.Column="1" Content="Export JSON" Margin="0,0,8,0"
                                            Click="OnExportDiagnosticsJsonClicked"/>
                                    <Button Grid.Column="2" Content="Clear"
                                            Click="OnClearDiagnosticsClicked"/>
                                </Grid>
                                <TextBlock Text="Recent merge and extension bridge events"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                 <TextBox x:Name="DiagnosticsLogBox"
                                          Height="220"
                                          TextWrapping="NoWrap"
                                          IsReadOnly="True"
                                          AcceptsReturn="True"
                                          FontFamily="Consolas"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
