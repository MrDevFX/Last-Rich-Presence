<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Last_Rich_Presence.MusicPageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer x:Name="MusicPageRoot"
                  VerticalScrollMode="Enabled"
                  VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <RepositionThemeTransition/>
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <!-- Empty State (shown when nothing is playing) -->
            <StackPanel x:Name="MusicEmptyState"
                        Visibility="Visible"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,60,0,0">
                <FontIcon Glyph="&#xE8D6;"
                          FontSize="64"
                          HorizontalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          Margin="0,0,0,16"/>
                <TextBlock Text="Nothing playing"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="Start playing something to see it here"
                           Style="{StaticResource SubtleCaptionTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Now Playing Card (shown when something is playing) -->
            <Border x:Name="NowPlayingCard"
                    Style="{StaticResource SettingsCardStyle}"
                    Padding="20"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="NOW PLAYING"
                                   Style="{StaticResource SectionOverlineTextStyle}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <Border Grid.Column="1"
                                Padding="10,4"
                                CornerRadius="999"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="PlayPauseIcon"
                                          Glyph="&#xE768;"
                                          FontSize="12"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="PlaybackStateText"
                                           Text="Idle"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Album Art -->
                        <Grid Width="96"
                              Height="96"
                              Margin="0,0,16,0"
                              CornerRadius="10"
                              VerticalAlignment="Top">
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                <FontIcon Glyph="&#xE8D6;"
                                          FontSize="34"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </Border>
                            <Image x:Name="AlbumThumbnail" Stretch="UniformToFill">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,96,96"/>
                                </Image.Clip>
                            </Image>
                        </Grid>

                        <!-- Song Info -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                            <TextBlock x:Name="SongTitle"
                                       Text="Nothing playing"
                                       Style="{StaticResource TrackTitleTextStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"/>
                            <TextBlock x:Name="ArtistName"
                                       Text="&#x2014;"
                                       Style="{StaticResource SecondaryBodyTextStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"/>
                            <TextBlock x:Name="AlbumName"
                                       Text=""
                                       Style="{StaticResource SubtleCaptionTextStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"/>
                        </StackPanel>
                    </Grid>

                    <Border Padding="12"
                            CornerRadius="8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       x:Name="PositionText"
                                       Text="0:00"
                                       Style="{StaticResource TimerTextStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Grid Grid.Column="1"
                                  x:Name="SongWaveViewport"
                                  Margin="12,0"
                                  Height="12"
                                  VerticalAlignment="Center">
                                <Border Height="12"
                                        CornerRadius="6"
                                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"/>

                                <Path x:Name="SongWaveTrackPath"
                                      Stretch="Fill"
                                      Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                                      StrokeThickness="1.25"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      VerticalAlignment="Center"
                                      Data="M0,6 C2.5,2 5,10 7.5,6 C10,2 12.5,10 15,6 C17.5,2 20,10 22.5,6 C25,2 27.5,10 30,6 C32.5,2 35,10 37.5,6 C40,2 42.5,10 45,6 C47.5,2 50,10 52.5,6 C55,2 57.5,10 60,6 C62.5,2 65,10 67.5,6 C70,2 72.5,10 75,6 C77.5,2 80,10 82.5,6 C85,2 87.5,10 90,6 C92.5,2 95,10 97.5,6 C100,2 102.5,10 105,6 C107.5,2 110,10 112.5,6 C115,2 117.5,10 120,6"/>

                                <Grid>
                                    <Grid.Clip>
                                        <RectangleGeometry x:Name="SongWaveFillClip"
                                                           Rect="0,0,0,12"/>
                                    </Grid.Clip>
                                    <Path x:Name="SongWaveFillPath"
                                          Stretch="Fill"
                                          Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Opacity="0.95"
                                          VerticalAlignment="Center"
                                          Data="M0,6 C2.5,2 5,10 7.5,6 C10,2 12.5,10 15,6 C17.5,2 20,10 22.5,6 C25,2 27.5,10 30,6 C32.5,2 35,10 37.5,6 C40,2 42.5,10 45,6 C47.5,2 50,10 52.5,6 C55,2 57.5,10 60,6 C62.5,2 65,10 67.5,6 C70,2 72.5,10 75,6 C77.5,2 80,10 82.5,6 C85,2 87.5,10 90,6 C92.5,2 95,10 97.5,6 C100,2 102.5,10 105,6 C107.5,2 110,10 112.5,6 C115,2 117.5,10 120,6">
                                        <Path.RenderTransform>
                                            <TranslateTransform x:Name="SongWaveFillTransform"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>

                                <ProgressBar x:Name="SongProgressBar"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"
                                             Height="1"
                                             Opacity="0"
                                             IsHitTestVisible="False"
                                             Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock Grid.Column="2"
                                       x:Name="DurationText"
                                       Text="0:00"
                                       Style="{StaticResource TimerTextStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </Border>

                    <!-- Source Badge -->
                    <Border x:Name="SourceBadge"
                            Margin="0,2,0,0"
                            Padding="10,6"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE8D6;" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock x:Name="SourceText"
                                           Text="No source"
                                           Style="{StaticResource CaptionTextBlockStyle}"/>
                            </StackPanel>
                            <TextBlock x:Name="SourceDebugText"
                                       Text=""
                                       Visibility="Collapsed"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="18,4,0,0"
                                       TextWrapping="Wrap"
                                       MaxWidth="420"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ MUSIC SETTINGS (inside Music page) ============ -->
            <TextBlock Text="PRESENCE SETTINGS"
                       Style="{StaticResource SectionOverlineTextStyle}"
                       Margin="0,8,0,12"/>

            <!-- Show Timestamps -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Show Timestamps" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Display elapsed/remaining time on your profile"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  x:Name="TimestampToggle"
                                  IsOn="True"
                                  Toggled="OnTimestampToggled"
                                  VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Show Source App -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Show Source App" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Display which app/browser is playing"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  x:Name="SourceToggle"
                                  IsOn="True"
                                  Toggled="OnSourceToggled"
                                  VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Source Debug Mode -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Source Debug Mode" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Show appId, detection rule, and confidence score"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  x:Name="SourceDebugToggle"
                                  IsOn="False"
                                  Toggled="OnSourceDebugToggled"
                                  VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Show Paused Media -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Show Paused Media" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Keep presence visible when playback is paused"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  x:Name="PausedToggle"
                                  IsOn="True"
                                  Toggled="OnPausedToggled"
                                  VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Show Album Art on Discord -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Show Album Art" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Upload and display album cover on your Discord profile"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  x:Name="AlbumArtToggle"
                                  IsOn="True"
                                  Toggled="OnAlbumArtToggled"
                                  VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Supported Sources info -->
            <Border Style="{StaticResource SettingsCardStyle}" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Supported Sources"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,0,0,8"/>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Spotify, Apple Music, YouTube Music (browser), Tidal, Deezer, foobar2000, VLC, MusicBee, AIMP, Winamp, iTunes, Groove Music, SoundCloud (browser), Amazon Music, and any app that uses Windows Media Controls."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
