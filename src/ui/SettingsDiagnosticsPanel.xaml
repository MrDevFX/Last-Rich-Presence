<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Last_Rich_Presence.SettingsDiagnosticsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="APP INFO" Style="{StaticResource SectionOverlineTextStyle}"
                   Margin="0,0,0,12"/>

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel Spacing="10">
                <Grid MinHeight="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56"
                            Margin="0,0,12,0"
                            CornerRadius="12"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png"
                               Width="44" Height="44"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="Last Rich Presence" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Desktop Discord Rich Presence bridge"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="v2.5.0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Text="Shows your current activity context on Discord using Windows media sessions and browser hints when available."/>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <TextBlock Text="HOW IT WORKS"
                           Style="{StaticResource SectionOverlineTextStyle}"/>
                <StackPanel Spacing="4">
                    <TextBlock TextWrapping="Wrap"
                               Style="{StaticResource SecondaryBodyTextStyle}"
                               Text="1. Detects media sessions from Windows and supported browsers."/>
                    <TextBlock TextWrapping="Wrap"
                               Style="{StaticResource SecondaryBodyTextStyle}"
                               Text="2. Converts track details and playback state into Discord Rich Presence."/>
                    <TextBlock TextWrapping="Wrap"
                               Style="{StaticResource SecondaryBodyTextStyle}"
                               Text="3. Keeps your profile updated while playback changes."/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="SUPPORT" Style="{StaticResource SectionOverlineTextStyle}"
                   Margin="0,16,0,12"/>

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel Spacing="8">
                <TextBlock Text="Verification command" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBox Text=".\scripts\verify.ps1"
                         IsReadOnly="True"
                         FontFamily="Cascadia Mono"
                         TextWrapping="NoWrap"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                <TextBlock Text="Run this before sharing issue reports so build/runtime checks are included."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <TextBlock Text="DIAGNOSTICS" Style="{StaticResource SectionOverlineTextStyle}"
                   Margin="0,16,0,12"/>

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Runtime Log" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <Button Grid.Column="1" Content="Export JSON" Margin="0,0,8,0"
                            Click="OnExportJsonClicked"/>
                    <Button Grid.Column="2" Content="Clear"
                            Click="OnClearClicked"/>
                </Grid>
                <TextBlock Text="Recent merge and extension bridge events"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="DiagnosticsLogBox"
                         Height="220"
                         TextWrapping="NoWrap"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         FontFamily="Consolas"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
