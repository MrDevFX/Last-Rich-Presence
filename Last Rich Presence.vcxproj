  <Target Name="CopyVCRuntimeForInno" AfterTargets="Build" Condition="'$(Configuration)'=='Release-Inno'">
    <PropertyGroup>
      <VCToolsMajorMinor>$([System.String]::Copy('$(VCToolsVersion)').Substring(0, 5))</VCToolsMajorMinor>
    </PropertyGroup>
    <ItemGroup>
      <VCRuntimeDlls Include="$(VCInstallDir)Redist\MSVC\$(VCToolsMajorMinor).*\x64\Microsoft.VC*.CRT\*.dll" />
    </ItemGroup>
    <ItemGroup>
      <VCRuntimeDlls Include="$(VCInstallDir)Redist\MSVC\*\x64\Microsoft.VC*.CRT\*.dll" Condition="'@(VCRuntimeDlls)'==''" />
    </ItemGroup>
    <Error Condition="'@(VCRuntimeDlls)'==''" Text="Could not locate VC++ runtime DLLs under $(VCInstallDir)Redist\\MSVC." />
    <Copy SourceFiles="@(VCRuntimeDlls)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="DeduplicateWindowsAppSdkAutoInitializers" BeforeTargets="WarnCompileDuplicatedFilename;ClCompile">
    <ItemGroup>
      <_WindowsAppSdkAutoInitializer Include="@(ClCompile)"
        Condition="'%(Filename)%(Extension)'=='WindowsAppRuntimeAutoInitializer.cpp' or '%(Filename)%(Extension)'=='UndockedRegFreeWinRT-AutoInitializer.cpp'" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_WindowsAppSdkAutoInitializer)">
      <Output TaskParameter="Filtered" ItemName="_UniqueWindowsAppSdkAutoInitializer" />
    </RemoveDuplicates>
    <ItemGroup Condition="'@(_WindowsAppSdkAutoInitializer)'!=''">
      <ClCompile Remove="@(_WindowsAppSdkAutoInitializer)" />
      <ClCompile Include="@(_UniqueWindowsAppSdkAutoInitializer)" />
    </ItemGroup>
  </Target>
